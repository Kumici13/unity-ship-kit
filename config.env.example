# unity-ship-kit config — copy to config.env and fill in values.
# config.env is in .gitignore. NEVER commit it.
# The build bot needs: PLAY_SERVICE_ACCOUNT, KEYSTORE_*, the "Build bot" section below.

# ── Legacy CLIs (ship.py / ship_android.py run directly) ──────────────────────
# The bot ignores this: it picks each project's editor from ProjectVersion.txt.
UNITY_PATH=/Applications/Unity/Hub/Editor/6000.0.60f1/Unity.app/Contents/MacOS/Unity

# Absolute path to your Unity project root (the folder containing Assets/, ProjectSettings/)
REPO_PATH=/Users/me/MyUnityProject

# iOS bundle identifier (must match what's in App Store Connect)
BUNDLE_ID=com.mycompany.myapp

# Apple Developer Team ID (10-char) — find at developer.apple.com → Membership
TEAM_ID=ABCDE12345

# App Store Connect API key
# Create at: appstoreconnect.apple.com → Users & Access → Keys → "+"
# Role: at minimum "Developer". Download the .p8 ONCE — store securely.
ASC_KEY_ID=ABC123XYZ
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=/Users/me/Keys/AuthKey_ABC123XYZ.p8

# ── Optional (have defaults) ─────────────────────────────────────────────────

# BUILD_OUTPUT=/tmp/ios-build
# ARCHIVE_PATH=/tmp/build.xcarchive
# EXPORT_PATH=/tmp/build-export
# BUILD_METHOD=BuildScript.BuildiOS

# ── Android / Google Play (ship_android.py) ──────────────────────────────────

# Service account JSON with "Release Manager" on every app.
# Play Console → Users and permissions → invite the service account email.
# e.g. /Users/me/.config/play/service-account.json
PLAY_SERVICE_ACCOUNT=

# Where .aab files are written (one per app key).
# ANDROID_BUILD_OUTPUT=/tmp/android-builds

# Tool overrides — only set these if the defaults fail.
# Unity editors live in <UNITY_EDITORS_DIR>/<version>/Unity.app (Unity Hub default).
# UNITY_EDITORS_DIR=/Applications/Unity/Hub/Editor
# java / jarsigner default to the OpenJDK inside the editor's Android module.
# JAVA_PATH=
# JARSIGNER_PATH=
# BUNDLETOOL_PATH=   # default: tools/bundletool.jar (setup.sh downloads it)

# Keystores, keyed by the "keystore" field in projects.json.
# ALIASPASS falls back to PASS when the alias password is the same.
# List the aliases in a keystore with:  keytool -list -keystore <path>
# "keystore": "main" in projects.json → KEYSTORE_MAIN_*.
KEYSTORE_MAIN_PATH=/Users/me/.keystores/main.keystore
KEYSTORE_MAIN_PASS=
# KEYSTORE_MAIN_ALIASPASS=

# ── Build bot (bot.py + pipeline.py) ─────────────────────────────────────────

DISCORD_TOKEN=
# Your server: right-click server → Copy Server ID. Commands only register here.
DISCORD_GUILD_ID=
# #builds channel: commands are refused anywhere else.
BUILD_CHANNEL_ID=
# Your user ID: gets an FYI when a build runs on a game your editor has open.
OWNER_DISCORD_ID=
# Optional: only members with this role may use commands and buttons (default: whole channel).
ALLOWED_ROLE_ID=
# Optional: role for 📤 Upload to Play (default: ALLOWED_ROLE_ID).
UPLOAD_ROLE_ID=

# Nightly QA build (dev + cheats APK, + TestFlight where iOS is set up) of every game's main
# branch at this local hour (skipped when no new commits). Opt a game out with "nightly": false in projects.json.
NIGHTLY_HOUR=3

# Clones, artifacts, logs, queue state. ~100 GB for all games (Library caches).
WORK_DIR=~/ShipKit
# UNITY_CLI=~/.unity/bin/unity

# Shared Drive for APK/AAB links. Add PLAY_SERVICE_ACCOUNT's client_email as
# Content Manager and enable the Drive API in its GCP project.
DRIVE_SHARED_DRIVE_ID=
# Who can open build links: anyone (anyone with the link), domain (+ DRIVE_DOMAIN=example.com), none.
DRIVE_SHARING=anyone
# DRIVE_DOMAIN=

# App Store Connect API key (App Manager role) + team, for iOS → TestFlight.
# An app under another team sets "asc_prefix": "CLIENT" + "team_id" in projects.json
# and gets CLIENT_KEY_ID / CLIENT_ISSUER_ID / CLIENT_KEY_PATH here.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
TEAM_ID=
# Minimum iOS version stamped into every iOS build (ASC requires 15.0+ from Spring 2027).
IOS_MIN_VERSION=15.0
# true = declare every iOS build exempt from export compliance (ITSAppUsesNonExemptEncryption=NO),
# so TestFlight skips the question. Only if your apps use nothing but the OS's HTTPS — it's a
# legal declaration. Unset = answer it in App Store Connect.
# IOS_EXEMPT_ENCRYPTION=true
